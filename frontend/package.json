    "@testing-library/user-event": "^14.6.4",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2"
