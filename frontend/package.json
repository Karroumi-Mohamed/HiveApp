{
  "name": "hiveapp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check .",
    "format": "biome check --write .",
    "verify": "bun run check && bun run typecheck && bun test && bun run build"
  },
